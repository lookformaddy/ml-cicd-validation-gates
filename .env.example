# ML CI/CD Validation Gates - example environment
# Copy to .env and tune. The demo CLI reads these via config_from_env().
MLGATES_SEED=42
MLGATES_N_ROWS=2000
MLGATES_TRAINER=logreg
MLGATES_ACCURACY_FLOOR=0.65
MLGATES_LATENCY_BUDGET_MS=50
MLGATES_REQUIRE_APPROVAL=1
MLGATES_HOST=127.0.0.1
MLGATES_PORT=8000
MLGATES_LOG_LEVEL=INFO
